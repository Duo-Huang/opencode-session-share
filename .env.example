# OpenCode Session Share service
# Copy to .env and fill in real values. Do not commit .env.

# Format: device-id:secret, multiple devices separated by commas.
# Generate one secret per device with: openssl rand -hex 32
SHARE_KEYS=my-mac:replace-with-64-hex-secret

# Stable HMAC salt used to look up shares by session ID.
# Generate once with: openssl rand -hex 32
# Do not rotate it, or existing shares can no longer be found.
SHARE_SESSION_SALT=replace-with-64-hex-salt

# URL users will open. For local testing use http://localhost:47821.
# For public use, use your HTTPS reverse-proxy URL.
SHARE_PUBLIC_BASE_URL=http://localhost:47821

# Used by compose.ghcr.yml. Pin a release tag for reproducible deployments.
SHARE_VERSION=latest

# Share lifetime and limits.
SHARE_DEFAULT_TTL_DAYS=1
SHARE_MAX_TTL_DAYS=30
SHARE_MAX_BYTES=15728640
SHARE_VIEW_MAX_BYTES=131072
SHARE_DB_MAX_MB=1024

# Optional Cloudflare edge cache + exact purge.
# Leave empty to disable edge caching; the service still works.
CF_ZONE_ID=
CF_CACHE_PURGE_TOKEN=
