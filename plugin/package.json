{
  "name": "opencode-session-share-plugin",
  "version": "0.1.1",
  "description": "Share an OpenCode session through a self-hosted read-only viewer",
  "type": "module",
  "license": "MIT",
  "author": "Duo Huang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Duo-Huang/opencode-session-share.git"
  },
  "homepage": "https://github.com/Duo-Huang/opencode-session-share#readme",
  "bugs": {
    "url": "https://github.com/Duo-Huang/opencode-session-share/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "session",
    "share",
    "tui"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./server.ts"
    },
    "./tui": {
      "types": "./src/tui.ts",
      "import": "./tui.ts"
    },
    "./rpc": {
      "types": "./src/rpc.ts",
      "import": "./rpc.ts"
    }
  },
  "files": [
    "server.ts",
    "tui.ts",
    "rpc.ts",
    "src/client.ts",
    "src/compact.ts",
    "src/index.ts",
    "src/normalize.ts",
    "src/rpc.ts",
    "src/storage.ts",
    "src/tui.ts",
    "src/types.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun test && bunx tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.0"
  }
}
